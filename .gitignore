# ---- Java / Maven 构建产物 ----
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# ---- 运行时数据（向量库落盘文件，可随时重新摄取生成） ----
data/

# ---- 个人文件（学生手册为扫描型 PDF 且含个人信息，不入库） ----
docs/knowledge/*.pdf

# ---- IDE 与编辑器 ----
.idea/
*.iml
.vscode/
*.code-workspace
# 编辑器插件生成的本地技能目录（含大量第三方模板，与项目无关）
.trae/

# ---- 日志与临时文件 ----
*.log
*.tmp
.DS_Store
Thumbs.db
# Windows 保留设备名：某些工具误建后无法用常规 API 删除，
# 不忽略会让 `git add .` 直接报 "short read while indexing nul"
nul

# ---- 环境变量文件（密钥安全） ----
.env
.env.*

# ---- 本地文档备份（含面试手册等个人资料与旧提交历史，绝不入库） ----
docs/ai-agent-backup-*/
.local-backup/
