<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 父项目：统一管理所有 Spring 官方依赖的版本号 -->
    <!-- 版本对齐说明：Spring AI 2.0.1 的 starter 硬编码依赖 Boot 4.1.1 模块，
         Boot 3.5.x 会与之产生 Jackson 自动配置 Bean 冲突，故必须使用 Boot 4.1.1 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.bank</groupId>
    <artifactId>bank-agent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>bank-agent</name>
    <description>企业级智能业务助手 Agent（以金融场景为验证）- 面试准备项目</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Web 启动器：内嵌 Tomcat 服务器 + Spring MVC，提供 HTTP 接口能力 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring AI OpenAI 启动器：智谱提供 OpenAI 兼容端点，复用此适配器 -->
        <!-- 注意：1.0 正式版后构件命名从 spring-ai-openai-spring-boot-starter 改为 spring-ai-starter-model-openai -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- 向量存储核心模块：含 VectorStore 抽象接口和 SimpleVectorStore 内存实现 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store</artifactId>
        </dependency>

        <!-- PGVector 向量存储启动器：把向量数据持久化到 PostgreSQL（pgvector 扩展）。
             替代 SimpleVectorStore 的"内存 + JSON 落盘"方案，重启不丢、可多实例共享。
             starter 自动配置 PgVectorStore Bean，业务代码只依赖 VectorStore 接口，零改动 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>

        <!-- 会话记忆 JDBC 持久化：MessageWindowChatMemory 的历史消息落数据库，
             替代默认的 InMemoryChatMemoryRepository（重启后同会话不再失忆） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-chat-memory-repository-jdbc</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC 驱动：向量库与会话记忆共用一个库 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JDBC 支撑（DataSource + JdbcTemplate）：长期画像自建表也走同一数据源 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Markdown 文档读取器：按标题层级把 .md 文件切成语义完整的段落 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-markdown-document-reader</artifactId>
        </dependency>

        <!-- PDF 文档读取器：基于 Apache PDFBox，按页提取 PDF 文本 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-pdf-document-reader</artifactId>
        </dependency>

        <!-- MCP Server（WebMVC/SSE 传输）：把本应用的工具暴露为 MCP 服务，
             供 Cursor、Claude Desktop 等任何 MCP 客户端调用 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- Lombok：注解自动生成 getter/setter 等样板代码 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot 测试支持 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- BOM（Bill of Materials，物料清单）：统一管理 Spring AI 全家桶的版本，
         之后引入任何 spring-ai-xxx 模块都不用再写版本号 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
